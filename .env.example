# SyncVault Backup & Restore — Environment Configuration
NODE_ENV="production"
PORT=3000
TZ="Europe/Warsaw"
DATA_DIR="/data"
RCLONE_CONFIG="/data/rclone.conf"
RCLONE_CONFIG_PATH="/data/rclone.conf"
MAX_CONCURRENT_JOBS="2"

# Notification settings (can also be configured via Web UI)
DISCORD_WEBHOOK_URL=""
NTFY_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="syncvault@localhost"
NOTIFY_EMAIL_TO=""
